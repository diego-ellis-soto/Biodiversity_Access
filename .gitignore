# Paper figures/tables: analysis outputs, not app assets. Keeping them out also
# avoids Hugging Face's binary-file rejection, which has no LFS rule for *.png
# (only the two www/ logos are tracked by exact path).
outputs/paper_BAS_vs_IBBAI/
outputs/city_briefing/
outputs/results/connectivity/
outputs/results/transit/

# Editor/working backups - never deploy these
*.bak
*.bak[0-9]

# Local rollback copies of large reference files - regenerable, never commit
outputs/results/*_pre_transit.rds
outputs/results/*_backup.rds

# SF EJ 999 fix: staging outputs and pre-fix backups (code/prep/fix_sf_ej_nodata.R)
outputs/results/ej_fix/
